{
  "manifest_version": "1.0",
  "extension_id": "yeelight",
  "name": "Yeelight",
  "version": "1.0.0",
  "author": "Đinh Trung Kiên",
  "description": "Yeelight LAN control driver. Supports power, brightness, RGB, and color temperature control via direct TCP connection. Includes SSDP-based network discovery.",
  "provider": {
    "key": "yeelight",
    "display_name": "Yeelight"
  },
  "package": {
    "runtime": "python",
    "entrypoint": "yeelight.py",
    "hooks": {
      "validate_command": "validate_command",
      "execute_command": "execute_command",
      "probe_state": "probe_state",
      "discover_devices": "discover_devices"
    }
  },
  "device_schemas": [
    {
      "schema_id": "yeelight_white_light",
      "name": "Yeelight White Light",
      "default_name": "Yeelight White Light",
      "description": "Yeelight white-spectrum LED bulb or lamp. Supports power and brightness control.",
      "device_type": "light",
      "display": {
        "card_type": "light",
        "capabilities": ["power", "brightness"]
      },
      "config_schema": {
        "fields": [
          {
            "key": "ip_address",
            "label": "IP Address",
            "type": "string",
            "required": true
          }
        ]
      }
    },
    {
      "schema_id": "yeelight_ambient_light",
      "name": "Yeelight Ambient Light",
      "default_name": "Yeelight Ambient Light",
      "description": "Yeelight ambient LED with adjustable color temperature.",
      "device_type": "light",
      "display": {
        "card_type": "light",
        "capabilities": ["power", "brightness", "color_temperature"],
        "temperature_range": {"min": 1700, "max": 6500}
      },
      "config_schema": {
        "fields": [
          {
            "key": "ip_address",
            "label": "IP Address",
            "type": "string",
            "required": true
          }
        ]
      }
    },
    {
      "schema_id": "yeelight_color_light",
      "name": "Yeelight Color Light",
      "default_name": "Yeelight Color Light",
      "description": "Yeelight full-color RGB LED bulb or lamp.",
      "device_type": "light",
      "display": {
        "card_type": "light",
        "capabilities": ["power", "brightness", "rgb", "color_temperature"],
        "temperature_range": {"min": 1700, "max": 6500}
      },
      "config_schema": {
        "fields": [
          {
            "key": "ip_address",
            "label": "IP Address",
            "type": "string",
            "required": true
          }
        ]
      }
    },
    {
      "schema_id": "yeelight_full_spectrum_light",
      "name": "Yeelight Full Spectrum Light",
      "default_name": "Yeelight Full Spectrum Light",
      "description": "Yeelight full-spectrum LED with RGB and tunable white.",
      "device_type": "light",
      "display": {
        "card_type": "light",
        "capabilities": ["power", "brightness", "rgb", "color_temperature"],
        "temperature_range": {"min": 1700, "max": 6500}
      },
      "config_schema": {
        "fields": [
          {
            "key": "ip_address",
            "label": "IP Address",
            "type": "string",
            "required": true
          }
        ]
      }
    }
  ]
}
